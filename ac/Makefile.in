# Makefile template for MOM6
#
# Compiler flags are configured by autoconf's configure script.
#
# Source code dependencies are configured by makedep and saved to Makefile.dep.

FC = @FC@
LD = @FC@
PYTHON = @PYTHON@
MAKEDEP = @MAKEDEP@

DEFS = @DEFS@
CPPFLAGS = @CPPFLAGS@
FCFLAGS = @FCFLAGS@
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@
MAKEDEP_FLAGS = @MAKEDEP_FLAGS@
MAKEDEP_DIRS = @MAKEDEP_DIRS@

ifneq ($(TESTDRIVE_BUILD),)
FCFLAGS += -I$(TESTDRIVE_BUILD)/include
LIBS += $(TESTDRIVE_BUILD)/libtest-drive.a
test_MOM_string_functions.o MOM_string_functions_tests.o \
test_MOM_array_transform.o MOM_array_transform_tests.o \
test_numerical_testing_type.o numerical_testing_type_tests.o \
test_MOM_ANN.o MOM_ANN_tests.o: $(TESTDRIVE_BUILD)/libtest-drive.a
endif

-include Makefile.dep

.PHONY: build-testdrive
build-testdrive:
	@test -f "$(TESTDRIVE_SOURCE)/CMakeLists.txt" || \
	  { echo "Initialize test-drive: git submodule update --init pkg/test-drive" >&2; exit 1; }
	cmake -S "$(TESTDRIVE_SOURCE)" -B "$(TESTDRIVE_BUILD)" \
	  -DCMAKE_Fortran_COMPILER="$(FC)" \
	  -DCMAKE_Fortran_FLAGS="$(filter-out --coverage -fprofile-arcs -ftest-coverage,$(FCFLAGS))" \
	  -DCMAKE_BUILD_TYPE=Debug -DCMAKE_Fortran_FLAGS_DEBUG= \
	  -DBUILD_SHARED_LIBS=OFF -DTESTDRIVE_BUILD_TESTING=OFF
	cmake --build "$(TESTDRIVE_BUILD)" --target test-drive-lib

# Generate Makefile from template
Makefile: @srcdir@/ac/Makefile.in config.status
	./config.status


# Recursive wildcard (finds all files in $1 with suffixes in $2)
rwildcard=$(foreach d,$(wildcard $(1:=/*)),$(call rwildcard,$d,$2) $(filter $(subst *,%,$2),$d))


# Generate dependencies
.PHONY: depend
depend: Makefile.dep
Makefile.dep: $(call rwildcard,$(MAKEDEP_DIRS),*.h *.c *.inc *.F90)
	$(PYTHON) $(MAKEDEP) $(DEFS) -o Makefile.dep $(MAKEDEP_FLAGS) $(MAKEDEP_DIRS)


# Delete any files associated with configuration (including the Makefile).
.PHONY: distclean
distclean: clean
	# configure output
	rm -f config.log
	rm -f config.status
	rm -f Makefile
	rm -f path_names
	rm -f Makefile.dep


# This deletes all files generated by autoconf, including configure.
# It is more aggressive than automake's maintainer-clean.
# NOTE: Not a standard GNU target, this is for internal use only.
#   Don't be surprised if the name changes or if it disappears someday.
.PHONY: ac-clean
ac-clean: distclean
	rm -f @srcdir@/ac/aclocal.m4
	rm -rf @srcdir@/ac/autom4te.cache
	rm -f @srcdir@/configure
	rm -f @srcdir@/configure~
